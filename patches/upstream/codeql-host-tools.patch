             break;
         case EventType::Pattern:
             PrintByte("PATT");
-            PrintWord("%s_%u_%03lu", g_asmLabel.c_str(), g_agbTrack, event.param2);
+            // Pattern identifiers are emitted as unsigned labels; match the
+            // variadic argument type to the %lu conversion exactly.
+            PrintWord(
+                "%s_%u_%03lu",
