diff --git a/tools/gbagfx/gfx.c b/tools/gbagfx/gfx.c
index 1dfc38e2d0362cb8224f67f057f68ee7120dce9f..70c8c4c8961cd30a010621340ded1abefdff879d 100644
--- a/tools/gbagfx/gfx.c
+++ b/tools/gbagfx/gfx.c
@@ -386,7 +386,9 @@ void ReadTileImage(char *path, int tilesWidth, int metatileWidth, int metatileHe
 
 	image->width = tilesWidth * 8;
 	image->height = tilesHeight * 8;
-	image->pixels = calloc(tilesWidth * tilesHeight, tileSize);
+	// Promote dimensions before multiplication so the allocation size cannot
+	// overflow the narrower signed-int arithmetic used by image dimensions.
+	image->pixels = calloc((size_t)tilesWidth * (size_t)tilesHeight, (size_t)tileSize);
 
 	if (image->pixels == NULL)
 		FATAL_ERROR("Failed to allocate memory for pixels.\n");
