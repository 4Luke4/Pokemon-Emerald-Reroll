diff --git a/tools/gbagfx/convert_png.c b/tools/gbagfx/convert_png.c
index 58371229c06d0c036a23d55ffcbf5761d0089800..bb0dd1a4c2ea4b6462624034c3c0755e24b47caa 100644
--- a/tools/gbagfx/convert_png.c
+++ b/tools/gbagfx/convert_png.c
@@ -97,14 +97,16 @@ void ReadPng(char *path, struct Image *image)
     image->width = png_get_image_width(png_ptr, info_ptr);
     image->height = png_get_image_height(png_ptr, info_ptr);
 
-    int rowbytes = png_get_rowbytes(png_ptr, info_ptr);
+    png_size_t rowbytes = png_get_rowbytes(png_ptr, info_ptr);
 
-    image->pixels = malloc(image->height * rowbytes);
+    // Keep the product in size_t so a large PNG cannot wrap signed-int
+    // arithmetic into an undersized destination buffer.
+    image->pixels = malloc((size_t)image->height * rowbytes);
 
     if (image->pixels == NULL)
         FATAL_ERROR("Failed to allocate pixel buffer.\n");
 
-    png_bytepp row_pointers = malloc(image->height * sizeof(png_bytep));
+    png_bytepp row_pointers = malloc((size_t)image->height * sizeof(png_bytep));
 
