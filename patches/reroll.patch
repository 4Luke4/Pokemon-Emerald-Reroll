+void Reroll_ReplaceBallGift(void)
+{
+    if (gSpecialVar_0x8000 >= FIRST_BALL && gSpecialVar_0x8000 <= LAST_BALL)
+    {
+        InitializeRandom();
+        gSpecialVar_0x8000 = sPickupItems[StrongRandomRange(ARRAY_COUNT(sPickupItems))];
+        gSpecialVar_0x8001 = 1;
+    }
+}
